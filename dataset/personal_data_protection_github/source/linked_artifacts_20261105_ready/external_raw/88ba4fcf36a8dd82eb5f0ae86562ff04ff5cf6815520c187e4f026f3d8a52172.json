  "text": "\n\n\n\n\n\n\n\n\n<!doctype html>\n\n<html class=\"windows no-js\" lang=\"en\" dir=\"ltr\" data-country-code=\"CN\" data-needs-consent=\"False\" data-latest-firefox=\"159.0.1\" data-esr-versions=\"153.6.0\" data-gtm-container-id=\"GTM-MW3R8V\"  data-stub-attribution-rate=\"1.0\" data-sentry-dsn=\"https://c3ab8514873549d5b3785ebc7fb83c80@o1069899.ingest.sentry.io/6260331\" >\n  <head>\n    <meta charset=\"utf-8\">\n\n    <!--[if !IE]><!-->\n    <script src=\"https://www.mozilla.org/media/js/site.c6d6f1fa36a4.js\"></script>\n\n    \n    <!--<![endif]-->\n\n    <!--[if IE 9]>\n    <script src=\"https://www.mozilla.org/media/js/site-ie.419ec4b57d17.js\"></script>\n    <![endif]-->\n\n<!--\n\n\n             _.-~-.\n           7''  Q..\\\n        _7         (_\n      _7  _/    _q.  /\n    _7 . ___  /VVvv-'_                                            .\n   7/ / /~- \\_\\\\      '-._     .-'                      /       //\n  ./ ( /-~-/||'=.__  '::. '-~'' {             ___   /  //     ./{\n V   V-~-~| ||   __''_   ':::.   ''~-~.___.-'' _/  // / {_   /  {  /\n  VV/-~-~-|/ \\ .'__'. '.    '::                     _ _ _        ''.\n  / /~~~~||VVV/ /  \\ )  \\        _ __ ___   ___ ___(_) | | __ _   .::'\n / (~-~-~\\\\.-' /    \\'   \\::::. | '_ ` _ \\ / _ \\_  / | | |/ _` | :::'\n/..\\    /..\\__/      '     '::: | | | | | | (_) / /| | | | (_| | ::'\nvVVv    vVVv                 ': |_| |_| |_|\\___/___|_|_|_|\\__,_| ''\n\nHi there, nice to meet you!\n\nInterested in having a direct impact on hundreds of millions of users? Join\nMozilla, and become part of a global community that’s helping to build a\nbrighter future for the Web.\n\nVisit https://www.mozilla.org/careers to learn about our current job openings.\nVisit https://www.mozilla.org/contribute for more ways to get involved and\nhelp support Mozilla.\n-->\n\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    \n\n    \n    <title>Mozilla Privacy</title>\n    <meta name=\"description\" content=\"\n  Our Privacy Notices describe the data our products and services receive, share, and use, as well as choices available to you.\n\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:site_name\" content=\"Mozilla\">\n    <meta property=\"og:locale\" content=\"en_US\">\n    <meta property=\"og:url\" content=\"https://www.mozilla.org/en-US/privacy/\">\n    <meta property=\"og:image\" content=\"https://www.mozilla.org/media/img/m24/og.3a69dffad83e.png\">\n    <meta property=\"og:title\" content=\"Mozilla Privacy\">\n    <meta property=\"og:description\" content=\"\n  Our Privacy Notices describe the data our products and services receive, share, and use, as well as choices available to you.\n\">\n    <meta property=\"fb:page_id\" content=\"262134952380\">\n    <meta name=\"twitter:card\" content=\"summary\">\n    <meta name=\"twitter:site\" content=\"@mozilla\">\n    <meta name=\"twitter:domain\" content=\"mozilla.org\">\n    <meta name=\"twitter:app:name:googleplay\" content=\"Firefox\">\n    <meta name=\"twitter:app:id:googleplay\" content=\"org.mozilla.firefox\">\n    <meta name=\"twitter:app:name:iphone\" content=\"Firefox\">\n    <meta name=\"twitter:app:id:iphone\" content=\"989804926\">\n    <meta name=\"twitter:app:name:ipad\" content=\"Firefox\">\n    <meta name=\"twitter:app:id:ipad\" content=\"989804926\">\n    <link rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"https://www.mozilla.org/media/img/favicons/mozilla/apple-touch-icon.05aa000f6748.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"196x196\" href=\"https://www.mozilla.org/media/img/favicons/mozilla/favicon-196x196.e143075360ea.png\">\n    <link rel=\"shortcut icon\" href=\"https://www.mozilla.org/media/img/favicons/mozilla/favicon.d0be64e474b1.ico\">\n    <link rel=\"canonical\" href=\"https://www.mozilla.org/en-US/privacy/\">\n    \n    <link rel=\"alternate\" hreflang=\"cs\" href=\"https://www.mozilla.org/cs/privacy/\" titl