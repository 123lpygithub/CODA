      "user": {
        "login": "csharrison",
        "id": 1066818,
        "node_id": "MDQ6VXNlcjEwNjY4MTg=",
        "avatar_url": "https://avatars.githubusercontent.com/u/1066818?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/csharrison",
        "html_url": "https://github.com/csharrison",
        "followers_url": "https://api.github.com/users/csharrison/followers",
        "following_url": "https://api.github.com/users/csharrison/following{/other_user}",
        "gists_url": "https://api.github.com/users/csharrison/gists{/gist_id}",
        "starred_url": "https://api.github.com/users/csharrison/starred{/owner}{/repo}",
        "subscriptions_url": "https://api.github.com/users/csharrison/subscriptions",
        "organizations_url": "https://api.github.com/users/csharrison/orgs",
        "repos_url": "https://api.github.com/users/csharrison/repos",
        "events_url": "https://api.github.com/users/csharrison/events{/privacy}",
        "received_events_url": "https://api.github.com/users/csharrison/received_events",
        "type": "User",
