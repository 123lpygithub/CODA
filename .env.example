# No real credentials. setup_local.py creates .env only when absent.
# run_local.py loads .env automatically; existing shell exports take priority.
# Other scripts: set -a; source .env; set +a

CODA_LLM_PROVIDER=rightapi
RIGHTAPI_API_KEY=''

# Default RightAPI role models are preserved when CODA_LLM_MODEL is unset.
# For another provider, set BOTH PROVIDER and MODEL and its corresponding key:
# CODA_LLM_PROVIDER=deepseek
# CODA_LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=''
# OPENAI_API_KEY=''
# DASHSCOPE_API_KEY=''
# GEMINI_API_KEY=''
# OPENROUTER_API_KEY=''

# Custom OpenAI-compatible endpoint:
# CODA_LLM_PROVIDER=custom
# CODA_LLM_MODEL=your-model-id
# CODA_LLM_BASE_URL=https://your-service.example/v1
# CODA_LLM_API_KEY_ENV=MY_MODEL_API_KEY
# MY_MODEL_API_KEY=''

# Optional per-role overrides (also used by initialization coders):
# CODA_CODER_A_PROVIDER=qwen
# CODA_CODER_A_MODEL=qwen-plus
# CODA_CODER_A_BASE_URL=https://your-region-endpoint/compatible-mode/v1
# DASHSCOPE_API_KEY=''
# CODA_CODER_B_MODEL=another-model-on-the-global-provider
# CODA_STAGE_MODEL=your-context-comparison-validation-model
# CODA_INDUCTION_MODEL=your-initialization-model

CODA_LLM_TIMEOUT_SECONDS=180
CODA_LLM_RETRY_TIMEOUTS_FOREVER=true
CODA_LLM_JSON_MODE=true
# CODA_LLM_MAX_OUTPUT_TOKENS=6000
# CODA_LLM_SEND_TEMPERATURE=false
# CODA_LLM_TOKEN_LIMIT_PARAMETER=max_completion_tokens

CODA_API_PORT=8003
# Development Vite server only; not used by run_local.py.
CODA_FRONTEND_PORT=5173
CODA_RUNS_ROOT=runs/web

# Optional revised source evidence. Use its matching study manifest for new runs;
# leave unset to retain the evidence used by the 2026-11-02 frozen allocation.
# CODA_EVIDENCE_PROFILE=paper-20261105
# Further archival recovery; use the expanded evidence manifest for new runs:
# CODA_EVIDENCE_PROFILE=paper-20261105-expanded
# Earlier recovery, including explicitly ambiguous SATD candidate locations:
# CODA_EVIDENCE_PROFILE=paper-20261105-continued
# Frozen v7 inputs: related-history SATD contexts and explicit external
# Privacy context. Partial evidence stays labelled; use the matching manifest.
# CODA_EVIDENCE_PROFILE=paper-20261105-ready
# Further deleted-file/tracker recovery; matching frozen inputs are v8:
# CODA_EVIDENCE_PROFILE=paper-20261105-recovered
# Latest verified collection: source attachment and additional historical files;
# use experiments/materials/evidence-20261106-v10 for matched paper runs.
# CODA_EVIDENCE_PROFILE=paper-20261106-v10

# When serving the frontend from another origin, restart the backend with:
# CODA_ALLOWED_ORIGINS=https://coda-workbench.pages.dev,https://coda.example.org
# Exact origins only. CORS is not authentication; see deploy/README.md.
